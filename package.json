{
  "name": "ballpoint",
  "version": "0.0.0",
  "private": true,
  "description": "A shadcn-style component registry drawn in blue ballpoint.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm registry:build && pnpm paper && next dev",
    "build": "pnpm registry:build && pnpm paper && next build",
    "start": "next start",
    "paper": "node scripts/paper-tiles.ts && node scripts/scrollbar-art.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "node scripts/contrast.ts --quiet && node scripts/build-registry.ts && shadcn build",
    "test:install": "node scripts/test-install.ts",
    "contrast": "node scripts/contrast.ts",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "bench": "node scripts/bench.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test visual",
    "test:a11y": "playwright test a11y"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.8.0"
}
